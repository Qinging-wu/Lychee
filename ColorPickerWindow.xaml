<Window x:Class="Lychee.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Precise color" Width="382" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FF1E232B" Foreground="#FFE2E8EF"
        FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="250"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="42"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" ClipToBounds="True" BorderBrush="#FF58616C" BorderThickness="1">
            <Canvas x:Name="SpectrumCanvas" Background="Red" MouseLeftButtonDown="Spectrum_MouseDown"
                    MouseMove="Spectrum_MouseMove" MouseLeftButtonUp="Spectrum_MouseUp">
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse x:Name="SpectrumMarker" Width="18" Height="18" Stroke="White" StrokeThickness="2"
                         Fill="#22000000" IsHitTestVisible="False"/>
            </Canvas>
        </Border>
        <Slider x:Name="HueSlider" Grid.Row="0" Grid.Column="1" Margin="0,4,2,14" Minimum="0" Maximum="359"
                Orientation="Vertical" ValueChanged="Hue_Changed" IsSnapToTickEnabled="False">
            <Slider.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="Red" Offset="0"/><GradientStop Color="#FFFF00" Offset="0.17"/>
                    <GradientStop Color="#00FF00" Offset="0.33"/><GradientStop Color="#00FFFF" Offset="0.5"/>
                    <GradientStop Color="#0000FF" Offset="0.67"/><GradientStop Color="#FF00FF" Offset="0.83"/>
                    <GradientStop Color="Red" Offset="1"/>
                </LinearGradientBrush>
            </Slider.Background>
        </Slider>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Hex:" VerticalAlignment="Center" Foreground="#FF9BA8B7"/>
        <TextBox x:Name="HexTextBox" Grid.Row="1" Grid.Column="0" Margin="50,0,0,8" Height="34"
                 TextAlignment="Center" VerticalContentAlignment="Center" FontFamily="Consolas"
                 TextChanged="Hex_Changed"/>
        <Border x:Name="ColorSwatch" Grid.Row="1" Grid.Column="1" Width="38" Height="34" CornerRadius="4"
                BorderBrush="#FF8995A3" BorderThickness="1" Margin="0,0,2,8"/>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="R:" VerticalAlignment="Center" Foreground="#FFFF6666"/>
            <TextBox x:Name="RedTextBox" Grid.Row="0" Grid.Column="1" MaxLength="3" VerticalContentAlignment="Center" TextChanged="RgbText_Changed"/>
            <Slider x:Name="RedSlider" Grid.Row="0" Grid.Column="2" Minimum="0" Maximum="255" ValueChanged="RgbSlider_Changed"/>
            <TextBlock Grid.Row="1" Text="G:" VerticalAlignment="Center" Foreground="#FF73C878"/>
            <TextBox x:Name="GreenTextBox" Grid.Row="1" Grid.Column="1" MaxLength="3" VerticalContentAlignment="Center" TextChanged="RgbText_Changed"/>
            <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="2" Minimum="0" Maximum="255" ValueChanged="RgbSlider_Changed"/>
            <TextBlock Grid.Row="2" Text="B:" VerticalAlignment="Center" Foreground="#FF65A8F0"/>
            <TextBox x:Name="BlueTextBox" Grid.Row="2" Grid.Column="1" MaxLength="3" VerticalContentAlignment="Center" TextChanged="RgbText_Changed"/>
            <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="2" Minimum="0" Maximum="255" ValueChanged="RgbSlider_Changed"/>
        </Grid>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="78" Height="28" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Choose" Width="78" Height="28" IsDefault="True" Click="Choose_Click"/>
        </StackPanel>
    </Grid>
</Window>
