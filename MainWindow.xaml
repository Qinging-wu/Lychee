<Window x:Class="Lychee.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Lychee.Controls"
        Title="Lychee"
        Height="440" Width="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        SizeChanged="Window_SizeChanged"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="ModuleNameBrush" Color="#FFCCCCCC"/>
        <SolidColorBrush x:Key="ModuleValueBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ModuleDetailBrush" Color="#FF8F8F9F"/>
        <FontFamily x:Key="ModuleFontFamily">Segoe UI</FontFamily>
    </Window.Resources>
    <Canvas x:Name="RootCanvas" ClipToBounds="True">
        <!-- Info panel (position set from code) -->
        <Border x:Name="PanelBorder" Canvas.Left="0" Canvas.Top="4" Width="260"
                Background="#E61E1E2E" CornerRadius="12" Visibility="Collapsed">
            <DockPanel LastChildFill="True" Margin="6">
                <Border DockPanel.Dock="Top" Background="#33FFFFFF" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                    <Grid>
                        <TextBlock Text="Lychee" Foreground="#FFB5DE56" FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="PinButton" Click="Pin_Click" ToolTip="Pin / Unpin"
                                    Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                    FontSize="14" Foreground="White" Cursor="Hand">📌</Button>
                            <Button x:Name="SettingsButton" Click="Settings_Click" ToolTip="Settings"
                                    Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                    FontSize="14" Foreground="White" Cursor="Hand">⚙</Button>
                            <Button x:Name="HideButton" Click="Hide_Click" ToolTip="Collapse"
                                    Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                    FontSize="18" Foreground="White" Cursor="Hand">›</Button>
                            <Button x:Name="QuitButton" Click="Quit_Click" ToolTip="Quit Lychee"
                                    Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                    FontSize="14" FontWeight="Bold" Foreground="#FFEB5757" Cursor="Hand">✕</Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="ModuleList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22FFFFFF" CornerRadius="6" Padding="8,6" Margin="0,3"
                                        ToolTip="{Binding Detail}">
                                    <DockPanel>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                           Foreground="#FFF85556" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ModuleNameBrush}"
                                                           FontFamily="{DynamicResource ModuleFontFamily}" FontSize="11"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding CurrentValue}" Foreground="{DynamicResource ModuleValueBrush}"
                                                       FontFamily="{DynamicResource ModuleFontFamily}" FontSize="13"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <controls:AudioSpectrumView Height="80" Margin="0,8,0,1"
                                                                        AutomationProperties.Name="16-band audio spectrum">
                                                <controls:AudioSpectrumView.Style>
                                                    <Style TargetType="controls:AudioSpectrumView">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="audio-meter">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:AudioSpectrumView.Style>
                                            </controls:AudioSpectrumView>
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource ModuleDetailBrush}"
                                                       FontFamily="{DynamicResource ModuleFontFamily}" FontSize="10"
                                                       TextWrapping="Wrap" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Soft circular glow behind the ball -->
        <Ellipse x:Name="BallGlow" Canvas.Left="0" Canvas.Top="0" Width="56" Height="56"
                 IsHitTestVisible="False" Opacity="0.6">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#005B8CFF" Offset="0"/>
                    <GradientStop Color="#FF5B8CFF" Offset="0.85"/>
                    <GradientStop Color="#005B8CFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Floating ball (position set from code) -->
        <Ellipse x:Name="BallEllipse" Canvas.Left="4" Canvas.Top="4" Width="48" Height="48"
                 RenderTransformOrigin="0.5,0.5"
                 MouseLeftButtonDown="Ball_MouseLeftButtonDown"
                 MouseLeftButtonUp="Ball_MouseLeftButtonUp"
                 MouseMove="Ball_MouseMove"
                 Cursor="SizeAll">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BallScale" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="BallRotate" Angle="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <ImageBrush ImageSource="Assets/icon.png" Stretch="UniformToFill"/>
            </Ellipse.Fill>
        </Ellipse>
    </Canvas>
</Window>
