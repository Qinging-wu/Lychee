<Window x:Class="Lychee.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lychee Settings"
        Width="380" Height="550"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Lychee Settings" Foreground="#FFB5DE56"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="Always show panel" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <CheckBox x:Name="AlwaysShowCheckBox" DockPanel.Dock="Right"
                          Checked="AlwaysShow_Changed" Unchecked="AlwaysShow_Changed"
                          HorizontalAlignment="Right" Background="#FF5B8CFF" BorderBrush="#FF5B8CFF"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="#22FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="Alert on IP change" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <CheckBox x:Name="AlertIpCheckBox" DockPanel.Dock="Right"
                          Checked="AlertIp_Changed" Unchecked="AlertIp_Changed"
                          HorizontalAlignment="Right" Background="#FF5B8CFF" BorderBrush="#FF5B8CFF"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="#22FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Frame monitoring (Experimental)" Foreground="White" FontSize="13"/>
                    <TextBlock Text="PresentMon runs only in application mode"
                               Foreground="#FF888898" FontSize="10" Margin="0,2,8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="142">
                    <ComboBox x:Name="FrameModeComboBox" Height="28"
                              SelectionChanged="FrameMode_Changed">
                        <ComboBoxItem Content="Desktop output" Tag="DesktopOutput"/>
                        <ComboBoxItem Content="Foreground app" Tag="ForegroundApplication"/>
                    </ComboBox>
                    <Button x:Name="RestartElevatedButton" Content="Restart as administrator"
                            Click="RestartElevated_Click" Height="25" Margin="0,5,0,0"
                            FontSize="10" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#22FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="Snap to edge" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <CheckBox x:Name="SnapCheckBox" DockPanel.Dock="Right"
                          Checked="Snap_Changed" Unchecked="Snap_Changed"
                          HorizontalAlignment="Right" Background="#FF5B8CFF" BorderBrush="#FF5B8CFF"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="5" Background="#22FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="Do NOT check this" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <CheckBox x:Name="BouncyBallCheckBox" DockPanel.Dock="Right"
                          Checked="BouncyBall_Changed" Unchecked="BouncyBall_Changed"
                          HorizontalAlignment="Right" Background="#FF5B8CFF" BorderBrush="#FF5B8CFF"/>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="6" Text="Info Modules" Foreground="#FFCCCCCC" FontSize="12" Margin="0,8,0,6"/>

        <Border Grid.Row="7" Background="#22FFFFFF" CornerRadius="8" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ModuleToggleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#33FFFFFF" CornerRadius="6" Padding="10,8" Margin="2">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="#FFF85556" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="13"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ModuleEnabledCheckBox"
                                              DockPanel.Dock="Right"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Checked="ModuleToggle_Changed"
                                              Unchecked="ModuleToggle_Changed"
                                              HorizontalAlignment="Right"
                                              Background="#FF5B8CFF" BorderBrush="#FF5B8CFF"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="8" Text="Lychee - Config: %AppData%\Lychee\settings.json"
                   Foreground="#888888" FontSize="10" Margin="0,12,0,0"/>
    </Grid>
</Window>
