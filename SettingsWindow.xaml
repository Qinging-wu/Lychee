<Window x:Class="Lychee.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lychee Settings"
        Width="380" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Lychee Settings" Foreground="#FFB5DE56"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
            <DockPanel>
                <TextBlock Text="Always show panel" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <CheckBox x:Name="AlwaysShowCheckBox" DockPanel.Dock="Right"
                          Checked="AlwaysShow_Changed" Unchecked="AlwaysShow_Changed"
                          HorizontalAlignment="Right" Background="#FF5B8CFF" BorderBrush="#FF5B8CFF"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="#22FFFFFF" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
            <DockPanel>
                <TextBlock Text="Alert on IP change" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <CheckBox x:Name="AlertIpCheckBox" DockPanel.Dock="Right"
                          Checked="AlertIp_Changed" Unchecked="AlertIp_Changed"
                          HorizontalAlignment="Right" Background="#FF5B8CFF" BorderBrush="#FF5B8CFF"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="#22FFFFFF" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
            <DockPanel>
                <TextBlock Text="Alert on IP query failure" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <CheckBox x:Name="AlertQueryFailCheckBox" DockPanel.Dock="Right"
                          Checked="AlertQueryFail_Changed" Unchecked="AlertQueryFail_Changed"
                          HorizontalAlignment="Right" Background="#FF5B8CFF" BorderBrush="#FF5B8CFF"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Background="#22FFFFFF" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Frame monitoring" Foreground="White" FontSize="13"/>
                    <TextBlock Text="PresentMon runs only in application mode"
                               Foreground="#FF888898" FontSize="10" Margin="0,1,8,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="142">
                    <ComboBox x:Name="FrameModeComboBox" Height="28"
                              SelectionChanged="FrameMode_Changed">
                        <ComboBoxItem Content="Desktop output" Tag="DesktopOutput"/>
                        <ComboBoxItem Content="Foreground app" Tag="ForegroundApplication"/>
                    </ComboBox>
                            <Button x:Name="RestartElevatedButton" Content="Restart as administrator"
                            Click="RestartElevated_Click" Height="25" Margin="0,3,0,0"
                            FontSize="10" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="#22FFFFFF" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
            <DockPanel>
                <TextBlock Text="Snap to edge" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <CheckBox x:Name="SnapCheckBox" DockPanel.Dock="Right"
                          Checked="Snap_Changed" Unchecked="Snap_Changed"
                          HorizontalAlignment="Right" Background="#FF5B8CFF" BorderBrush="#FF5B8CFF"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="6" Background="#22FFFFFF" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
            <DockPanel>
                <TextBlock Text="Do NOT click this" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <CheckBox x:Name="BouncyBallCheckBox" DockPanel.Dock="Right"
                          Checked="BouncyBall_Changed" Unchecked="BouncyBall_Changed"
                          HorizontalAlignment="Right" Background="#FF5B8CFF" BorderBrush="#FF5B8CFF"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="7" Background="#22FFFFFF" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="142"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Style" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <ComboBox x:Name="BallStyleComboBox" Grid.Column="1" Height="28"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                          SelectionChanged="BallStyle_Changed"/>
                <Button Grid.Column="1" Content="Import image..." Height="25" Margin="0,34,0,0"
                        Click="ImportBallImage_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <Expander x:Name="AppearanceExpander" Grid.Row="8" Header="Custom panel appearance"
                  Foreground="#FFCCCCCC" Margin="0,2,0,4">
            <Border Background="#22FFFFFF" CornerRadius="8" Padding="8" Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="UseCustomAppearanceCheckBox" Grid.Row="0" Grid.ColumnSpan="2"
                              Content="Enable custom appearance"
                              Foreground="White" FontSize="12"
                              Checked="UseCustomAppearance_Changed" Unchecked="UseCustomAppearance_Changed"
                              Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Text="Background RGB" Foreground="#FFCCCCCC"
                               VerticalAlignment="Center" FontSize="11"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="2">
                        <TextBlock Text="R" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBox x:Name="BackgroundRedTextBox" Width="38" MaxLength="3" TextChanged="AppearanceColor_Changed"/>
                        <TextBlock Text="G" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="5,0,2,0"/>
                        <TextBox x:Name="BackgroundGreenTextBox" Width="38" MaxLength="3" TextChanged="AppearanceColor_Changed"/>
                        <TextBlock Text="B" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="5,0,2,0"/>
                        <TextBox x:Name="BackgroundBlueTextBox" Width="38" MaxLength="3" TextChanged="AppearanceColor_Changed"/>
                        <Button Content="Precise…" Height="24" Margin="6,0,0,0" Padding="6,0"
                                Click="PickBackgroundColor_Click" Cursor="Hand"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Text RGB" Foreground="#FFCCCCCC"
                               VerticalAlignment="Center" FontSize="11"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="2">
                        <TextBlock Text="R" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBox x:Name="TextRedTextBox" Width="38" MaxLength="3" TextChanged="AppearanceColor_Changed"/>
                        <TextBlock Text="G" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="5,0,2,0"/>
                        <TextBox x:Name="TextGreenTextBox" Width="38" MaxLength="3" TextChanged="AppearanceColor_Changed"/>
                        <TextBlock Text="B" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="5,0,2,0"/>
                        <TextBox x:Name="TextBlueTextBox" Width="38" MaxLength="3" TextChanged="AppearanceColor_Changed"/>
                        <Button Content="Precise…" Height="24" Margin="6,0,0,0" Padding="6,0"
                                Click="PickTextColor_Click" Cursor="Hand"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="Background opacity" Foreground="#FFCCCCCC"
                               VerticalAlignment="Center" FontSize="11"/>
                    <DockPanel Grid.Row="3" Grid.Column="1" Margin="2">
                        <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" Width="34"
                                   TextAlignment="Right" Foreground="White" VerticalAlignment="Center"/>
                        <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="100" TickFrequency="5"
                                IsSnapToTickEnabled="False" ValueChanged="BackgroundOpacity_Changed"/>
                    </DockPanel>

                    <TextBlock Grid.Row="4" Text="Font" Foreground="#FFCCCCCC"
                               VerticalAlignment="Center" FontSize="11"/>
                    <DockPanel Grid.Row="4" Grid.Column="1" Margin="2">
                        <Button Content="Reset default" DockPanel.Dock="Right" Height="25" Margin="6,0,0,0"
                                Click="ResetAppearance_Click" Cursor="Hand"/>
                        <ComboBox x:Name="PanelFontComboBox" Height="25" IsEditable="True"
                                  IsTextSearchEnabled="True" DisplayMemberPath="Source" SelectedValuePath="Source"
                                  SelectionChanged="PanelFont_Changed"/>
                    </DockPanel>

                    <TextBlock Grid.Row="5" Text="Preview" Foreground="#FFCCCCCC"
                               VerticalAlignment="Center" FontSize="11"/>
                    <Border x:Name="AppearancePreviewBorder" Grid.Row="5" Grid.Column="1"
                            CornerRadius="5" Padding="7,5" Margin="2" BorderBrush="#44808080" BorderThickness="1">
                        <TextBlock x:Name="AppearancePreviewText" Text="Lychee  ·  Sample text 123"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Border>
        </Expander>

        <TextBlock Grid.Row="9" Text="Info Modules" Foreground="#FFCCCCCC" FontSize="12" Margin="0,4,0,3"/>

        <Border Grid.Row="10" Background="#22FFFFFF" CornerRadius="8" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ModuleToggleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#33FFFFFF" CornerRadius="6" Padding="8,5" Margin="2,1">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="#FFF85556" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="13"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ModuleEnabledCheckBox"
                                              DockPanel.Dock="Right"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Checked="ModuleToggle_Changed"
                                              Unchecked="ModuleToggle_Changed"
                                              HorizontalAlignment="Right"
                                              Background="#FF5B8CFF" BorderBrush="#FF5B8CFF"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="11" Text="Lychee - Config: %AppData%\Lychee\settings.json"
                   Foreground="#888888" FontSize="10" Margin="0,12,0,0"/>
    </Grid>
</Window>
